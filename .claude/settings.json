{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_env_edit.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context-mode@context-mode": true,
    "ponytail@ponytail": true,
    "git@sneaxiii-plugins": true
  },
  "extraKnownMarketplaces": {
    "sneaxiii-plugins": {
      "source": {
        "source": "github",
        "repo": "SNEAXIII/sneaxiii-plugins"
      }
    }
  }
}
