# Copy to .env — read by the Rust worker (`cargo run --bin worker --features worker`).
# Required, as in Mawster's api.env: the same broker, described the same way.
RABBITMQ_URL=amqp://mawster:mawster@localhost:5672/%2f

# Required: the worker refuses to boot without them. Values from compose-dev.yaml.
RUSTFS_ACCESS_KEY=mawster
RUSTFS_SECRET_KEY=mawsterpassword
# Optional: defaults to http://rustfs:9000, only resolved inside the Docker network.
RUSTFS_ENDPOINT=http://localhost:9000

# Optional: these defaults, relative to the working directory.
# DETECTOR_MODEL=artifacts-vision/artifacts/yolo/best.onnx
# DIGITS_MODEL=artifacts-vision/artifacts/ocr/digits.onnx
# GALLERY_FILE=artifacts/gallery/mosaic.bin
