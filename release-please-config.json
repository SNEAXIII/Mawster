{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "mawster",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "api/main.py",
        { "type": "toml", "path": "static-assets/Cargo.toml", "jsonpath": "$.package.version" },
        {
          "type": "toml",
          "path": "static-assets/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='mawster-static-files')].version"
        }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Changed" },
    { "type": "revert", "section": "Reverted" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "chore", "section": "Internal", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true }
  ]
}
