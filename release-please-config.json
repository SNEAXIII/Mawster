{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "mawster",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "api/main.py",
        {
          "type": "toml",
          "path": "api/pyproject.toml",
          "jsonpath": "$.project.version"
        }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Ajouté" },
    { "type": "fix", "section": "Corrigé" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Modifié" },
    { "type": "revert", "section": "Annulé" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "chore", "section": "Interne", "hidden": true },
    { "type": "ci", "section": "Intégration continue", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true }
  ]
}
