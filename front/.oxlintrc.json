{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "jsx-a11y", "react"],
  "categories": {
    "correctness": "off"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    ".next/**",
    ".next-3001/**",
    "node_modules/**",
    "cypress/**",
    "components/ui/**",
    "postcss.config.js",
    "**/*.d.ts"
  ],
  "rules": {
    "constructor-super": "error",
    "for-direction": "error",
    "getter-return": "error",
    "no-async-promise-executor": "error",
    "no-case-declarations": "error",
    "no-class-assign": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-const-assign": "error",
    "no-constant-binary-expression": "error",
    "no-constant-condition": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "no-delete-var": "error",
    "no-dupe-class-members": "error",
    "no-dupe-else-if": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty": "error",
    "no-empty-character-class": "error",
    "no-empty-pattern": "error",
    "no-empty-static-block": "error",
    "no-ex-assign": "error",
    "no-extra-boolean-cast": "error",
    "no-fallthrough": "error",
    "no-func-assign": "error",
    "no-global-assign": "error",
    "no-import-assign": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "error",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-new-native-nonconstructor": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-obj-calls": "error",
    "no-prototype-builtins": "error",
    "no-redeclare": "error",
    "no-regex-spaces": "error",
    "no-self-assign": "error",
    "no-setter-return": "error",
    "no-shadow-restricted-names": "error",
    "no-sparse-arrays": "error",
    "no-this-before-super": "error",
    "no-unassigned-vars": "error",
    "no-unreachable": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-labels": "error",
    "no-unused-private-class-members": "error",
    "no-unused-vars": [
      "error",
      {
        "vars": "all",
        "args": "after-used",
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-useless-backreference": "error",
    "no-useless-catch": "error",
    "no-useless-escape": "error",
    "no-with": "error",
    "preserve-caught-error": "error",
    "require-yield": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "no-array-constructor": "error",
    "no-unused-expressions": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": [
      "error",
      {
        "ignoreNonDOM": true
      }
    ],
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": [
      "error",
      {
        "tabbable": ["button", "checkbox", "link", "searchbox", "spinbutton", "switch", "textbox"]
      }
    ],
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": [
      "error",
      {
        "tr": ["none", "presentation"],
        "canvas": ["img"]
      }
    ],
    "jsx-a11y/no-noninteractive-element-interactions": [
      "error",
      {
        "handlers": [
          "onClick",
          "onError",
          "onLoad",
          "onMouseDown",
          "onMouseUp",
          "onKeyPress",
          "onKeyDown",
          "onKeyUp"
        ],
        "alert": ["onKeyUp", "onKeyDown", "onKeyPress"],
        "body": ["onError", "onLoad"],
        "dialog": ["onKeyUp", "onKeyDown", "onKeyPress"],
        "iframe": ["onError", "onLoad"],
        "img": ["onError", "onLoad"]
      }
    ],
    "jsx-a11y/no-noninteractive-element-to-interactive-role": [
      "error",
      {
        "ul": ["listbox", "menu", "menubar", "radiogroup", "tablist", "tree", "treegrid"],
        "ol": ["listbox", "menu", "menubar", "radiogroup", "tablist", "tree", "treegrid"],
        "li": ["menuitem", "menuitemradio", "menuitemcheckbox", "option", "row", "tab", "treeitem"],
        "table": ["grid"],
        "td": ["gridcell"],
        "fieldset": ["radiogroup", "presentation"]
      }
    ],
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      {
        "tags": [],
        "roles": ["tabpanel"],
        "allowExpressionValues": true
      }
    ],
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": [
      "error",
      {
        "allowExpressionValues": true,
        "handlers": ["onClick", "onMouseDown", "onMouseUp", "onKeyPress", "onKeyDown", "onKeyUp"]
      }
    ],
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "no-nested-ternary": "error",
    "react/exhaustive-deps": "warn",
    "typescript/ban-ts-comment": "warn",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "sonarjs/class-name": "warn",
    "sonarjs/no-fallthrough": "warn",
    "sonarjs/no-equals-in-for-termination": "warn",
    "sonarjs/no-extra-arguments": "warn",
    "sonarjs/no-labels": "warn",
    "sonarjs/no-nested-assignment": "warn",
    "sonarjs/no-redundant-boolean": "warn",
    "sonarjs/prefer-single-boolean-return": "warn",
    "sonarjs/fixme-tag": "warn",
    "sonarjs/todo-tag": "warn",
    "sonarjs/no-case-label-in-switch": "warn",
    "sonarjs/no-parameter-reassignment": "warn",
    "sonarjs/no-floating-point-equality": "warn",
    "sonarjs/prefer-while": "warn",
    "sonarjs/no-hardcoded-ip": "warn",
    "sonarjs/label-position": "warn",
    "sonarjs/public-static-readonly": "warn",
    "sonarjs/call-argument-line": "warn",
    "sonarjs/max-switch-cases": "warn",
    "sonarjs/no-unused-vars": "warn",
    "sonarjs/function-inside-loop": "warn",
    "sonarjs/code-eval": "warn",
    "sonarjs/future-reserved-words": "warn",
    "sonarjs/no-primitive-wrappers": "warn",
    "sonarjs/no-skipped-tests": "warn",
    "sonarjs/no-identical-expressions": "warn",
    "sonarjs/constructor-for-side-effects": "warn",
    "sonarjs/no-dead-store": "warn",
    "sonarjs/no-identical-conditions": "warn",
    "sonarjs/no-duplicated-branches": "warn",
    "sonarjs/no-inverted-boolean-check": "warn",
    "sonarjs/misplaced-loop-counter": "warn",
    "sonarjs/no-nested-functions": "warn",
    "sonarjs/no-hardcoded-passwords": "warn",
    "sonarjs/insecure-cookie": "warn",
    "sonarjs/no-useless-increment": "warn",
    "sonarjs/no-globals-shadowing": "warn",
    "sonarjs/no-empty-test-file": "warn",
    "sonarjs/pseudo-random": "warn",
    "sonarjs/for-loop-increment-sign": "warn",
    "sonarjs/updated-loop-counter": "warn",
    "sonarjs/block-scoped-var": "warn",
    "sonarjs/no-ignored-exceptions": "warn",
    "sonarjs/no-gratuitous-expressions": "warn",
    "sonarjs/file-uploads": "warn",
    "sonarjs/file-permissions": "warn",
    "sonarjs/no-unenclosed-multiline-block": "warn",
    "sonarjs/no-implicit-global": "warn",
    "sonarjs/no-useless-catch": "warn",
    "sonarjs/xml-parser-xxe": "warn",
    "sonarjs/non-existent-operator": "warn",
    "sonarjs/no-fixed-wait-in-tests": "warn",
    "sonarjs/no-incomplete-assertions": "warn",
    "sonarjs/no-global-this": "warn",
    "sonarjs/no-delete-var": "warn",
    "sonarjs/cookie-no-httponly": "warn",
    "sonarjs/no-nested-conditional": "warn",
    "sonarjs/inverted-assertion-arguments": "warn",
    "sonarjs/updated-const-var": "warn",
    "sonarjs/no-invariant-returns": "warn",
    "sonarjs/generator-without-yield": "warn",
    "sonarjs/comma-or-logical-or-case": "warn",
    "sonarjs/no-redundant-jump": "warn",
    "sonarjs/inconsistent-function-call": "warn",
    "sonarjs/no-use-of-empty-return-value": "warn",
    "sonarjs/cognitive-complexity": "warn",
    "sonarjs/no-all-duplicated-branches": "warn",
    "sonarjs/no-same-line-conditional": "warn",
    "sonarjs/no-unthrown-error": "warn",
    "sonarjs/no-unused-collection": "warn",
    "sonarjs/no-os-command-from-path": "warn",
    "sonarjs/no-element-overwrite": "warn",
    "sonarjs/no-identical-functions": "warn",
    "sonarjs/no-empty-collection": "warn",
    "sonarjs/no-redundant-assignments": "warn",
    "sonarjs/prefer-type-guard": "warn",
    "sonarjs/use-type-alias": "warn",
    "sonarjs/weak-ssl": "warn",
    "sonarjs/no-weak-keys": "warn",
    "sonarjs/csrf": "warn",
    "sonarjs/production-debug": "warn",
    "sonarjs/prefer-default-last": "warn",
    "sonarjs/no-duplicate-in-composite": "warn",
    "sonarjs/no-nested-template-literals": "warn",
    "sonarjs/prefer-promise-shorthand": "warn",
    "sonarjs/hashing": "warn",
    "sonarjs/unverified-certificate": "warn",
    "sonarjs/cors": "warn",
    "sonarjs/link-with-target-blank": "warn",
    "sonarjs/table-header": "warn",
    "sonarjs/no-table-as-layout": "warn",
    "sonarjs/table-header-reference": "warn",
    "sonarjs/object-alt-content": "warn",
    "sonarjs/no-clear-text-protocols": "warn",
    "sonarjs/publicly-writable-directories": "warn",
    "sonarjs/unverified-hostname": "warn",
    "sonarjs/encryption-secure-mode": "warn",
    "sonarjs/no-weak-cipher": "warn",
    "sonarjs/insecure-jwt-token": "warn",
    "sonarjs/x-powered-by": "warn",
    "sonarjs/content-length": "warn",
    "sonarjs/content-security-policy": "warn",
    "sonarjs/no-mime-sniff": "warn",
    "sonarjs/no-referrer-policy": "warn",
    "sonarjs/strict-transport-security": "warn",
    "sonarjs/no-same-argument-assert": "warn",
    "sonarjs/session-regeneration": "warn",
    "sonarjs/prefer-specific-assertions": "warn",
    "sonarjs/no-trivial-assertions": "warn",
    "sonarjs/test-check-exception": "warn",
    "sonarjs/stable-tests": "warn",
    "sonarjs/parameterized-tests": "warn",
    "sonarjs/no-code-after-done": "warn",
    "sonarjs/disabled-timeout": "warn",
    "sonarjs/chai-determinate-assertion": "warn",
    "sonarjs/aws-s3-bucket-insecure-http": "warn",
    "sonarjs/aws-s3-bucket-versioning": "warn",
    "sonarjs/aws-s3-bucket-granted-access": "warn",
    "sonarjs/no-angular-bypass-sanitization": "warn",
    "sonarjs/aws-iam-public-access": "warn",
    "sonarjs/aws-ec2-unencrypted-ebs-volume": "warn",
    "sonarjs/aws-s3-bucket-public-access": "warn",
    "sonarjs/aws-iam-all-privileges": "warn",
    "sonarjs/aws-rds-unencrypted-databases": "warn",
    "sonarjs/aws-opensearchservice-domain": "warn",
    "sonarjs/aws-iam-privilege-escalation": "warn",
    "sonarjs/aws-sagemaker-unencrypted-notebook": "warn",
    "sonarjs/aws-restricted-ip-admin-access": "warn",
    "sonarjs/aws-sns-unencrypted-topics": "warn",
    "sonarjs/aws-ec2-rds-dms-public": "warn",
    "sonarjs/aws-sqs-unencrypted-queue": "warn",
    "sonarjs/aws-efs-unencrypted": "warn",
    "sonarjs/aws-apigateway-public-api": "warn",
    "sonarjs/stateful-regex": "warn",
    "sonarjs/no-hardcoded-secrets": "warn",
    "sonarjs/no-exclusive-tests": "warn",
    "sonarjs/hardcoded-secret-signatures": "warn",
    "sonarjs/no-hook-setter-in-body": "warn",
    "sonarjs/no-useless-react-setstate": "warn",
    "sonarjs/no-uniq-key": "warn",
    "sonarjs/redundant-type-aliases": "warn",
    "sonarjs/no-internal-api-use": "warn",
    "sonarjs/no-literal-call": "warn",
    "sonarjs/review-blockchain-mnemonic": "warn",
    "sonarjs/dynamically-constructed-templates": "warn",
    "sonarjs/no-session-cookies-on-static-assets": "warn",
    "sonarjs/no-duplicate-test-title": "warn",
    "sonarjs/async-test-assertions": "warn",
    "sonarjs/no-empty-test-title": "warn",
    "sonarjs/hooks-before-test-cases": "warn",
    "sonarjs/no-forced-browser-interaction": "warn",
    "sonarjs/assertions-in-test-cases": "warn",
    "sonarjs/synchronous-suite-callback": "warn",
    "sonarjs/super-linear-regex": "warn",
    "sonarjs/prefer-native-lodash-alternative": "warn",
    "sonarjs/no-default-utility-imports": "warn",
    "sonarjs/memoize-cache-key": "warn",
    "sonarjs/no-debug-commands-in-ui-tests": "warn",
    "sonarjs/no-mixed-completion-style": "warn",
    "sonarjs/no-interpolation-in-inline-snapshots": "warn",
    "sonarjs/explicit-test-skip": "warn",
    "typescript/prefer-nullish-coalescing": [
      "warn",
      {
        "ignorePrimitives": {
          "boolean": true
        }
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
      "rules": {
        "constructor-super": "off",
        "getter-return": "off",
        "no-class-assign": "off",
        "no-const-assign": "off",
        "no-dupe-class-members": "off",
        "no-dupe-keys": "off",
        "no-func-assign": "off",
        "no-import-assign": "off",
        "no-new-native-nonconstructor": "off",
        "no-obj-calls": "off",
        "no-redeclare": "off",
        "no-setter-return": "off",
        "no-this-before-super": "off",
        "no-unreachable": "off",
        "no-unsafe-negation": "off",
        "no-var": "error",
        "no-with": "off",
        "prefer-const": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error"
      }
    },
    {
      "files": ["*.config.js", "*.config.mjs", "*.config.ts"],
      "globals": {
        "module": "writable",
        "require": "readonly",
        "process": "readonly",
        "__dirname": "readonly"
      }
    },
    {
      // Radix's PopoverTrigger renders `aria-controls={open ? contentId : undefined}`, so these
      // comboboxes get it exactly when the listbox is mounted; pointing at an absent element
      // while closed would be worse. The rule reads the JSX statically and cannot see that.
      "files": [
        "app/game/_components/searchable-player-filter-select.tsx",
        "app/game/alliances/_components/alliance-invite-member-combo.tsx",
        "app/game/knowledge-base/_components/champion-filter-select.tsx"
      ],
      "rules": {
        "jsx-a11y/role-has-required-aria-props": "off"
      }
    }
  ],
  "jsPlugins": ["eslint-plugin-sonarjs"]
}
