# eslint-plugin-jsx-a11y@6.10.2 caps its peer range at eslint 9 and has no release for
# eslint 10 yet, so a plain `npm ci` fails with ERESOLVE. The plugin is verified to run
# and to flag the real cases under eslint 10; this keeps local installs and the CI's
# `npm ci --ignore-scripts` resolving the same way.
# Drop this file once upstream widens the range.
legacy-peer-deps=true
