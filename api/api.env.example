# openssl rand -hex 64
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
MARIADB_USER=CHANGE_ME
MARIADB_PASSWORD=CHANGE_ME_strong_password
MARIADB_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MARIADB_PORT=3306
MARIADB_DATABASE=mawster
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_HASH_ROUND=12
# Origines CORS autorisées (séparées par des virgules), ex: https://mawster.example.com
ALLOWED_ORIGINS=CHANGE_ME_https://votre-domaine.com
# openssl rand -hex 32
EMAIL_PEPPER=CHANGE_ME_generate_with_openssl_rand_hex_32

# Identifiants des applications OAuth. Un access token n'est accepte que si le
# fournisseur declare qu'il a ete emis pour ceux-ci : sinon un token cree pour
# n'importe quelle autre application authentifierait son porteur ici. Ce sont des
# identifiants publics (Discord Developer Portal / console Google Cloud), pas des secrets.
DISCORD_CLIENT_ID=CHANGE_ME_discord_application_id
GOOGLE_CLIENT_ID=CHANGE_ME_google_oauth_client_id
